# IntraService Admin Panel — example environment
# Copy to your service environment / systemd unit. All values are placeholders.

# --- Where the bot lives (this panel reads the bot's state) ---
# The default resolves to a sibling directory named "intraservice-server-bot".
# Uncomment and adjust to point at your actual bot checkout:
# PANEL_BOT_DIR=/srv/intraservice-server-bot
# PANEL_BOT_DB=/srv/intraservice-server-bot/data/intake.sqlite3
# PANEL_MAIL_DB=/srv/intraservice-server-bot/data/mail_watcher.sqlite3

# --- Network ---
# PANEL_HOST=127.0.0.1
# PANEL_PORT=9120

# --- Auth store ---
# PANEL_AUTH_FILE=/srv/intraservice-admin-panel/data/auth.json

# --- Behind a trusted reverse proxy that terminates TLS ---
# PANEL_TRUST_PROXY=1

# --- Optional configuration writer (disabled by default) ---
# Requires write permission to the bot config/data directory.
# PANEL_ENABLE_CONFIG_WRITE=1
